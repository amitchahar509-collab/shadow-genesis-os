// SHADOW GENESIS OS — Autonomous AI Company Operating System schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ TASK GRAPH ============
model GenesisTask {
  id               String    @id @default(cuid())
  taskId           String    @unique // T-001
  title            String
  description      String
  ownerAgent       String    // CEO, RESEARCH, PRODUCT, ENGINEERING, AI_SYSTEMS, DESIGN, GROWTH, QUALITY
  department       String
  priority         String    @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  status           String    @default("PENDING") // PENDING | IN_PROGRESS | BLOCKED | REVIEW | DONE | FAILED
  progress         Int       @default(0) // 0-100
  dependencies     String    @default("[]") // JSON array of taskId
  expectedArtifact String
  validation       String
  estimatedHours   Int       @default(0)
  actualHours      Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  startedAt        DateTime?
  completedAt      DateTime?
}

// ============ MEMORY ARCHITECTURE ============
model MemoryEntry {
  id         String   @id @default(cuid())
  type       String   // EPISODIC | SEMANTIC | PROCEDURAL
  title      String
  content    String
  tags       String   @default("[]") // JSON array
  importance Int      @default(5) // 1-10
  source     String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ============ DEPARTMENTS ============
model Department {
  id             String   @id @default(cuid())
  key            String   @unique // ceo | research | product | engineering | ai_systems | design | growth | quality
  name           String
  mission        String
  status         String   @default("ACTIVE") // ACTIVE | IDLE | BLOCKED | OFFLINE
  health         Int      @default(100) // 0-100
  activeAgents   Int      @default(0)
  completedTasks Int      @default(0)
  pendingTasks   Int      @default(0)
  load           Int      @default(0) // 0-100
  metrics        String   @default("{}") // JSON
  updatedAt      DateTime @updatedAt
}

// ============ CEO DECISIONS ============
model CeoDecision {
  id        String   @id @default(cuid())
  title     String
  rationale String
  decision  String
  impact    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | CRITICAL
  status    String   @default("EXECUTED") // PROPOSED | APPROVED | EXECUTED | REVERSED
  createdAt DateTime @default(now())
}

// ============ RESEARCH DEPARTMENT ============
model ResearchReport {
  id         String   @id @default(cuid())
  topic      String
  category   String   // MARKET | COMPETITOR | USER | TECHNOLOGY | RISK | OPPORTUNITY
  summary    String
  findings   String   @default("[]") // JSON array
  evidence   String   @default("[]") // JSON array
  confidence Int      @default(70) // 0-100
  status     String   @default("PUBLISHED")
  createdAt  DateTime @default(now())
}

// ============ ACTIVITY FEED ============
model ActivityLog {
  id        String   @id @default(cuid())
  agent     String
  action    String
  detail    String
  level     String   @default("INFO") // INFO | SUCCESS | WARNING | ERROR | CRITICAL
  category  String   @default("SYSTEM") // TASK | BUILD | TEST | DEPLOY | SECURITY | MEMORY | DECISION | RESEARCH
  taskId    String?
  createdAt DateTime @default(now())
}

// ============ SYSTEM METRICS ============
model SystemMetric {
  id        String   @id @default(cuid())
  name      String   @unique
  value     Float
  unit      String
  category  String   // PERFORMANCE | COST | QUALITY | THROUGHPUT | RELIABILITY
  target    Float?
  updatedAt DateTime @updatedAt
}

// ============ GIT / BUILD CHECKPOINTS ============
model BuildCheckpoint {
  id          String   @id @default(cuid())
  version     String   @unique
  type        String   // COMMIT | RELEASE | ROLLBACK
  summary     String
  changesCount Int     @default(0)
  testsPassed Int      @default(0)
  testsFailed Int      @default(0)
  status      String   @default("PASSED") // PASSED | FAILED | ROLLBACK
  createdAt   DateTime @default(now())
}

// ============ OPERATIONAL LOOPS ============
model OperationalLoop {
  id          String    @id @default(cuid())
  key         String    @unique // self_correction | sandbox | git | security | model_orchestration | deployment | feedback | learning
  name        String
  description String
  status      String    @default("RUNNING") // RUNNING | PAUSED | IDLE | ERROR
  cycleCount  Int       @default(0)
  lastRunAt   DateTime?
  interval    String
  healthScore Int       @default(100)
  detail      String?
  updatedAt   DateTime  @updatedAt
}

// ============ GENESIS STATE (K/V) ============
model GenesisState {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============ PROJECT / COMPANY (V4 Phase 7) ============
model Project {
  id          String   @id @default(cuid())
  key         String   @unique // slug
  name        String
  mission     String
  type        String   @default("PRODUCT") // PRODUCT | SAAS | API | INTERNAL | EXPERIMENT
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED | KILLED
  repoPath    String?
  businessScore Float  @default(0) // 0-100 from validation engine
  priority    String   @default("MEDIUM") // CRITICAL | HIGH | MEDIUM | LOW
  metadata    String   @default("{}") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ AGENT EXECUTION (V3) ============
model AgentExecution {
  id                String   @id @default(cuid())
  executionId       String   @unique // EX-000001
  agent             String
  taskId            String?
  projectId         String?
  goal              String
  status            String   @default("PENDING") // PENDING | RUNNING | SUCCESS | FAILED | CANCELLED | RETRYING
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  result            String   @default("{}")
  error             String?
  toolCalls         Int      @default(0)
  artifactsCreated  Int      @default(0)
  retryCount        Int      @default(0)
  durationMs        Int      @default(0)
  tokensUsed        Int      @default(0)
  parentExecutionId String?
  createdAt         DateTime @default(now())
}

// ============ TOOL CALLS ============
model ToolCall {
  id           String   @id @default(cuid())
  executionId  String
  tool         String
  operation    String
  input        String   @default("{}")
  output       String   @default("{}")
  status       String   @default("SUCCESS")
  durationMs   Int      @default(0)
  errorMessage String?
  createdAt    DateTime @default(now())
}

// ============ ARTIFACTS ============
model Artifact {
  id           String   @id @default(cuid())
  executionId  String?
  taskId       String?
  projectId    String?
  type         String // FILE | DIRECTORY | REPORT | REPOSITORY | TEST_SUITE | DEPLOYMENT | DESIGN_DOC
  path         String
  description  String
  size         Int      @default(0)
  checksum     String?
  metadata     String   @default("{}")
  createdAt    DateTime @default(now())
}

// ============ TEST RUNS ============
model TestRun {
  id           String   @id @default(cuid())
  executionId  String?
  taskId       String?
  suite        String
  passed       Int      @default(0)
  failed       Int      @default(0)
  skipped      Int      @default(0)
  durationMs   Int      @default(0)
  status       String   @default("PASSED")
  output       String   @default("")
  createdAt    DateTime @default(now())
}

// ============ DEPLOYMENT RECORDS ============
model DeploymentRecord {
  id            String   @id @default(cuid())
  executionId   String?
  taskId        String?
  projectId     String?
  target        String // local | vercel | netlify | custom
  url           String?
  buildCmd      String
  envValidation String   @default("{}")
  status        String   @default("PENDING") // PENDING | BUILDING | VALIDATING | DEPLOYED | FAILED | UNHEALTHY
  health        String   @default("UNKNOWN") // UNKNOWN | HEALTHY | UNHEALTHY | NOT_RUNNING
  log           String   @default("")
  createdAt     DateTime @default(now())
}

// ============ AGENT COLLABORATION (V3 Phase 1) ============
model AgentMessage {
  id          String   @id @default(cuid())
  messageId   String   @unique // MSG-000001
  fromAgent   String
  toAgent     String
  type        String // DIRECTIVE | QUESTION | FINDINGS | APPROVE | REJECT | BLOCK | ALLOW | REQUEST_HELP | HELP_PROVIDED | DELEGATE
  payload     String   @default("{}")
  status      String   @default("SENT") // SENT | DELIVERED | READ | ACTED
  createdAt   DateTime @default(now())
}

model AgentState {
  id                  String   @id @default(cuid())
  agent               String   @unique
  state               String   @default("IDLE") // IDLE | THINKING | EXECUTING | REVIEWING | BLOCKED | DONE | PAUSED | OFFLINE
  currentExecutionId  String?
  currentTaskId       String?
  paused              Boolean  @default(false)
  updatedAt           DateTime @updatedAt
}

model AgentDecision {
  id          String   @id @default(cuid())
  decisionId  String   @unique // DEC-000001
  agent       String
  targetAgent String?
  taskId      String?
  executionId String?
  type        String // APPROVE | REJECT | REQUEST_REVISION | BLOCK | ALLOW
  rationale   String
  payload     String   @default("{}")
  status      String   @default("ACTIVE") // ACTIVE | OVERRIDDEN | SUPERSEDED
  requiresHumanApproval Boolean @default(false)
  humanStatus String? // PENDING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  decidedAt   DateTime?
}

// ============ SELF-IMPROVEMENT (V3 Phase 6) ============
model ExecutionAnalysis {
  id              String   @id @default(cuid())
  executionId     String   @unique
  agent           String
  whatWorked      String   @default("[]")
  whatFailed      String   @default("[]")
  whatWastedTime  String   @default("[]")
  recommendations String   @default("[]")
  improvementTaskIds String @default("[]")
  failureCategory String? // TOOL_ERROR | CODE_ERROR | MISSING_DEP | TIMEOUT | LLM_FAILURE | UNKNOWN
  createdAt       DateTime @default(now())
}

model FailureAnalysis {
  id            String   @id @default(cuid())
  executionId   String
  agent         String
  category      String
  rootCause     String
  pattern       String   @default("{}")
  recommendation String
  recurring     Boolean  @default(false)
  occurrences   Int      @default(1)
  createdAt     DateTime @default(now())
}

model PromptVersion {
  id           String   @id @default(cuid())
  agent        String
  version      Int
  systemPrompt String
  notes        String?
  active       Boolean  @default(false)
  successCount Int      @default(0)
  failCount    Int      @default(0)
  createdAt    DateTime @default(now())
}

// ============ OBSERVABILITY (V3 Phase 8) ============
model AgentMetric {
  id            String   @id @default(cuid())
  agent         String
  windowStart   DateTime
  windowEnd     DateTime
  successRate   Float
  avgDurationMs Int
  p95DurationMs Int
  toolCallCount Int
  artifactCount Int
  errorCount    Int
  createdAt     DateTime @default(now())
}

// ============ SECURITY (V3 Phase 9) ============
model SecurityFinding {
  id          String   @id @default(cuid())
  agent       String
  scope       String // ARTIFACT | DEPENDENCY | CONFIG | SOURCE
  scopeId     String?
  rule        String
  severity    String // CRITICAL | HIGH | MEDIUM | LOW
  message     String
  file        String?
  line        Int?
  status      String   @default("OPEN") // OPEN | ACKNOWLEDGED | FIXED | FALSE_POSITIVE
  blocksRelease Boolean @default(false)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?
}

// ============ SANDBOX (V3 Phase 3) ============
model Sandbox {
  id          String   @id @default(cuid())
  sandboxId   String   @unique // SBX-000001
  executionId String?
  projectId   String?
  path        String
  status      String   @default("ACTIVE") // ACTIVE | SNAPSHOTTED | CLEANED
  healthCheck String   @default("UNKNOWN") // UNKNOWN | HEALTHY | UNHEALTHY | NOT_RUNNING
  port        Int?
  pid         Int?
  logPath     String?
  ttlSeconds  Int      @default(86400)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ AGENT TEMPLATES (V3 Phase 10) ============
model AgentTemplate {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  systemPrompt String
  toolAllowlist String  @default("[]")
  defaultContext String @default("{}")
  isBuiltin    Boolean  @default(false)
  createdAt    DateTime @default(now())
}

// ============ V4 — OPPORTUNITY (Phase 2) ============
model Opportunity {
  id          String   @id @default(cuid())
  opportunityId String @unique // OPP-000001
  title       String
  problem     String
  market      String
  targetUsers String
  competition String   @default("{}")
  difficulty  Float    @default(5) // 1-10
  potentialValue Float @default(5) // 1-10
  evidence    String   @default("[]") // JSON of {url, snippet}[]
  confidence  Float    @default(50) // 0-100
  businessScore Float  @default(0) // 0-100 from validation
  status      String   @default("DISCOVERED") // DISCOVERED | VALIDATING | VALIDATED | KILLED | BUILDING | LAUNCHED
  source      String? // which scan found it
  tags        String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ V4 — BUSINESS VALIDATION (Phase 3) ============
model BusinessValidation {
  id            String   @id @default(cuid())
  opportunityId String   @unique
  demandScore   Float    @default(0) // 0-100
  competitionScore Float @default(0)
  timingScore   Float    @default(0)
  feasibilityScore Float @default(0)
  monetizationScore Float @default(0)
  overallScore  Float    @default(0) // weighted
  recommendation String  @default("REVIEW") // BUILD | REVIEW | KILL
  evidence      String   @default("{}")
  risks         String   @default("[]")
  channels      String   @default("[]")
  validatedAt   DateTime @default(now())
}

// ============ V4 — REVENUE (Phase 6) ============
model RevenueModel {
  id          String   @id @default(cuid())
  projectId   String?
  model       String   // SUBSCRIPTION | ONE_TIME | FREEMIUM | USAGE | ADS | MARKETPLACE | SERVICES
  pricing     String   @default("{}") // JSON of tiers
  forecast    String   @default("{}") // JSON of monthly projections
  costAnalysis String  @default("{}")
  status      String   @default("PROPOSED") // PROPOSED | ACTIVE | PAUSED | KILLED
  experiments String   @default("[]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevenueEvent {
  id          String   @id @default(cuid())
  projectId   String?
  type        String   // CHARGE | REFUND | SUBSCRIPTION | UPGRADE | CHURN
  amount      Float
  currency    String   @default("USD")
  customerId  String?
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())
}

// ============ V4 — GROWTH (Phase 5) ============
model GrowthExperiment {
  id           String   @id @default(cuid())
  projectId    String?
  name         String
  hypothesis   String
  variant      String   @default("A")
  metric       String
  startDate    DateTime @default(now())
  endDate      DateTime?
  status       String   @default("RUNNING") // legacy: RUNNING | COMPLETE | KILLED; acquisition engine: PROPOSED | AWAITING_APPROVAL | AWAITING_EXECUTION | LEARNED | KILLED
  result       String   @default("{}")
  createdAt    DateTime @default(now())
  // V8 G4 — Acquisition Engine loop fields (additive; legacy rows keep NULL/defaults)
  experimentId String?  @unique // EXP-000001
  subject      String? // opportunityId | companyKey the experiment belongs to
  kind         String   @default("GENERIC") // PRICING | AUDIENCE | CHANNEL | GENERIC
  dataSource   String   @default("NONE") // SIMULATION | REAL | NONE — honesty label on every measurement
  learning     String? // what worked / what failed / why (experiment memory)
  approvalId   String? // APR- id when the experiment needs a human-approved external action
  nextAction   String? // suggested follow-up experiment

  @@index([subject])
}

model GrowthMetric {
  id           String   @id @default(cuid())
  projectId    String?
  metric       String   // traffic | activation | retention | revenue
  value        Float
  unit         String   @default("count")
  period       String   @default("daily") // daily | weekly | monthly
  recordedAt   DateTime @default(now())
  createdAt    DateTime @default(now())
}

// ============ V4 — COMPANY (Phase 7) ============
model Company {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  mission     String
  status      String   @default("ACTIVE") // ACTIVE | PAUSED | ARCHIVED
  strategy    String   @default("{}") // JSON
  metrics     String   @default("{}") // JSON
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ V4 — KNOWLEDGE GRAPH (Phase 9) ============
model KnowledgeNode {
  id          String   @id @default(cuid())
  type        String   // CONCEPT | ENTITY | EVENT | PATTERN | DECISION
  label       String
  description String   @default("")
  properties  String   @default("{}")
  createdAt   DateTime @default(now())
}

model KnowledgeEdge {
  id          String   @id @default(cuid())
  fromNodeId  String
  toNodeId    String
  relation    String // RELATES_TO | CAUSED_BY | PART_OF | DEPENDS_ON | SIMILAR_TO
  weight      Float    @default(1)
  evidence    String   @default("[]")
  createdAt   DateTime @default(now())
}

// ============ V4 — REALITY FEEDBACK (Phase 13) ============
model RealitySignal {
  id          String   @id @default(cuid())
  projectId   String?
  type        String   // USER_FEEDBACK | ANALYTICS | MARKET_RESPONSE | PERFORMANCE | FAILURE
  source      String
  payload     String   @default("{}")
  sentiment   Float    @default(0) // -1 to 1
  impact      String   @default("UNKNOWN") // POSITIVE | NEUTRAL | NEGATIVE
  actedOn     Boolean  @default(false)
  createdAt   DateTime @default(now())
  // V8 G9 — Reality Feedback Brain (additive; legacy v4/reality rows keep defaults)
  signalId    String?  @unique // RS-000001
  kind        String   @default("USAGE") // ERROR | FEEDBACK | FEATURE_REQUEST | USAGE | RETENTION | CONVERSION
  productKey  String? // which deployed product/company reported this — REAL external origin
  subject     String? // opportunityId | companyKey — links a signal to the acquisition/operator loop
  generated   String   @default("[]") // JSON: {kind,id} of tasks/experiments/metrics this signal produced
  processedAt DateTime?

  @@index([subject])
  @@index([actedOn])
}

// ============ V4 — SELF AUDIT (Phase 14) ============
model SelfAudit {
  id          String   @id @default(cuid())
  question    String
  context     String   @default("{}")
  finding     String   @default("")
  recommendation String @default("")
  severity    String   @default("INFO") // INFO | WARNING | ERROR | CRITICAL
  actedOn     Boolean  @default(false)
  createdAt   DateTime @default(now())
}

// ============ V4 — TOOL REGISTRY (Phase 10) ============
model CustomTool {
  id           String   @id @default(cuid())
  key          String   @unique
  name         String
  description  String
  operations   String   @default("[]")
  permissions  String   @default("{}") // per-agent allowlist
  rating       Float    @default(0)
  usageCount   Int      @default(0)
  successRate  Float    @default(0)
  isBuiltin    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// ============ V4 — INTERNET OPERATOR (Phase 1) ============
model BrowserSession {
  id          String   @id @default(cuid())
  sessionId   String   @unique
  agent       String
  status      String   @default("IDLE") // IDLE | NAVIGATING | EXTRACTING | INTERACTING | CLOSED
  currentUrl  String?
  pagesVisited Int     @default(0)
  auditLog    String   @default("[]") // JSON of {action, url, timestamp, approved}
  requiresApproval Boolean @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============ V5 — AI BOARDROOM (Phase 4): no silent decisions ============
model BoardDecision {
  id           String   @id @default(cuid())
  decisionId   String   @unique // BOARD-000001
  topic        String
  question     String
  context      String   @default("{}") // JSON snapshot the board debated over (goal, plan, opportunity, signals)
  verdict      String   @default("CONDITIONAL") // GO | CONDITIONAL | NO_GO
  confidence   Float    @default(0) // 0-100, weighted board confidence in the verdict
  tally        String   @default("{}") // JSON { GO, NO_GO, ABSTAIN }
  synthesis    String   @default("") // final rationale reconciling the arguments
  conditions   String   @default("[]") // JSON string[] — must-hold conditions for GO/CONDITIONAL
  risks        String   @default("[]") // JSON string[] — surfaced risks/blind spots
  mode         String   @default("HEURISTIC") // LLM | HEURISTIC | MIXED — honest about how stances were formed
  projectId    String?
  missionId    String?
  artifactPath String?  // BOARD_DECISION.md on disk
  createdAt    DateTime @default(now())
  arguments    BoardArgument[]
}

model BoardArgument {
  id         String   @id @default(cuid())
  decisionId String
  role       String   // FOUNDER | CEO | INVESTOR | CUSTOMER | COMPETITOR | CFO | GROWTH | ENGINEER | RISK
  stance     String   @default("ABSTAIN") // GO | NO_GO | ABSTAIN
  argument   String
  concerns   String   @default("[]") // JSON string[]
  confidence Float    @default(50) // 0-100, this member's confidence in their own stance
  mode       String   @default("HEURISTIC") // LLM | HEURISTIC
  createdAt  DateTime @default(now())
  decision   BoardDecision @relation(fields: [decisionId], references: [decisionId], onDelete: Cascade)

  @@index([decisionId])
}

// ============ V6 — AI VENTURE ANALYST (Phase 3): judge every opportunity like a VC ============
model VentureAnalysis {
  id               String   @id @default(cuid())
  analysisId       String   @unique // VC-000001
  opportunityId    String? // links to Opportunity when scoring a discovered opportunity
  subject          String  // opportunity title or the raw goal analysed
  marketSize       Float    @default(0) // 0-100
  timing           Float    @default(0) // 0-100 (is now the moment?)
  moat             Float    @default(0) // 0-100 (defensibility)
  competition      Float    @default(0) // 0-100 (higher = weaker/less-crowded, more favorable)
  distribution     Float    @default(0) // 0-100 (repeatable, affordable reach)
  founderAdvantage Float    @default(0) // 0-100 (unfair advantage; baseline 50 when unknown)
  growthPotential  Float    @default(0) // 0-100 (power-law upside)
  ventureScore     Float    @default(0) // weighted 0-100
  verdict          String   @default("WATCH") // INVEST | WATCH | PASS
  thesis           String   @default("") // one-paragraph investment thesis
  risks            String   @default("[]") // JSON string[]
  unknowns         String   @default("[]") // JSON string[] — what we do NOT yet know (anti-hallucination)
  mode             String   @default("HEURISTIC") // LLM | HEURISTIC — honest about how scores were formed
  artifactPath     String? // VENTURE_SCORE.md on disk
  createdAt        DateTime @default(now())

  @@index([opportunityId])
}

// ============ V6 — AEGIS TRUTH ENGINE (Phase 1): never allow unsupported confidence ============
model Claim {
  id              String   @id @default(cuid())
  claimId         String   @unique // CLM-000001
  statement       String  // "Market demand for X is increasing"
  subject         String? // what this claim is about: opportunityId | analysisId | goal | topic
  category        String   @default("MARKET") // MARKET | DEMAND | COMPETITION | FEASIBILITY | TIMING | FINANCIAL | OTHER
  truthScore      Float    @default(0) // 0-100, evidence-weighted. 0 evidence ⇒ 0.
  verdict         String   @default("UNSUPPORTED") // SUPPORTED | CONTESTED | UNSUPPORTED
  supportCount    Int      @default(0)
  contradictCount Int      @default(0)
  unknowns        String   @default("[]") // JSON string[] — what remains unverified
  source          String? // which agent/execution asserted it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  evidence        Evidence[]

  @@index([subject])
}

model Evidence {
  id         String   @id @default(cuid())
  evidenceId String   @unique // EV-000001
  claimId    String
  stance     String   @default("SUPPORT") // SUPPORT | CONTRADICT | NEUTRAL
  summary    String
  source     String  // URL or provenance string
  sourceType String   @default("UNKNOWN") // WEB | MEMORY | COMPUTED | USER | SIMULATION | UNKNOWN
  weight     Float    @default(1) // 0-1 reliability of this piece of evidence
  createdAt  DateTime @default(now())
  claim      Claim    @relation(fields: [claimId], references: [claimId], onDelete: Cascade)

  @@index([claimId])
}

// ============ V7 — DIGITAL CUSTOMER SIMULATION (Phase 2): SIMULATED, never real users ============
model CustomerSimulation {
  id                  String   @id @default(cuid())
  simulationId        String   @unique // SIM-000001
  subject             String  // opportunity title / goal being tested
  opportunityId       String?
  personaCount        Int      @default(0) // how many virtual customers were simulated
  buyRate             Float    @default(0) // 0-100 % who would BUY
  maybeRate           Float    @default(0) // 0-100 % MAYBE
  realityScore        Float    @default(0) // 0-100 CUSTOMER_REALITY_SCORE
  avgWillingnessToPay Float    @default(0) // currency units / month
  pricePoints         String   @default("{}") // JSON { p25, median, p75 }
  topObjections       String   @default("[]") // JSON [{objection, count}]
  topTriggers         String   @default("[]") // JSON [{trigger, count}]
  missingFeatures     String   @default("[]") // JSON [{feature, count}]
  segments            String   @default("[]") // JSON per-industry breakdown
  mode                String   @default("HEURISTIC") // LLM | HEURISTIC — how personas/objections were formed
  artifactPath        String? // CUSTOMER_REALITY.md
  createdAt           DateTime @default(now())
  personas            CustomerPersona[] // a representative SAMPLE (not all N)

  @@index([opportunityId])
}

// ============ V8 — APPROVAL CONTROL CENTER (G2): human remains CEO ============
model ApprovalRequest {
  id          String    @id @default(cuid())
  requestId   String    @unique // APR-000001
  agent       String  // which agent asked
  executionId String?
  actionType  String  // EMAIL | POST | PAYMENT | PURCHASE | ACCOUNT | CUSTOMER_CONTACT | HTTP_WRITE | OTHER
  description String  // human-readable: what will happen if approved
  payload     String    @default("{}") // JSON — the exact action parameters (audit trail)
  riskScore   Float     @default(50) // 0-100
  riskFactors String    @default("[]") // JSON string[] — why the score
  status      String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXECUTED | EXPIRED
  decidedBy   String? // human identity that decided
  decisionNote String?
  requestedAt DateTime  @default(now())
  decidedAt   DateTime?
  executedAt  DateTime? // approvals are single-use: consuming one marks it EXECUTED
  expiresAt   DateTime? // pending requests expire (default 24h)

  @@index([status])
}

// ============ V8 — PLUGIN / SKILL MARKETPLACE (G11): installable agents/tools/workflows over real artifacts ============
model Plugin {
  id               String   @id @default(cuid())
  pluginId         String   @unique // PLG-000001
  kind             String   // AGENT | TOOL | WORKFLOW
  refKey           String   // wraps a REAL artifact: agent name | AgentTemplate.key | tool name | CustomTool.key | workflow id
  name             String
  description      String   @default("")
  version          Int      @default(1)
  source           String   @default("BUILTIN") // BUILTIN | EVOLUTION | USER
  status           String   @default("LISTED") // LISTED | INSTALLED | DEPRECATED
  installCount     Int      @default(0)
  invocations      Int      @default(0) // from real AgentExecution / ToolCall
  successes        Int      @default(0)
  failures         Int      @default(0)
  performanceScore Float    @default(0) // 0-100, real success rate
  benchmarkScore   Float    @default(0) // 0-100, last on-demand measurement (0 = unbenchmarked)
  trustScore       Float    @default(0) // 0-100, composite (source + performance × volume-confidence + benchmark)
  benchmarkedAt    DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  versions         PluginVersion[]

  @@unique([kind, refKey])
  @@index([kind])
  @@index([status])
}

model PluginVersion {
  id         String   @id @default(cuid())
  pluginId   String
  version    Int
  changelog  String   @default("")
  config     String   @default("{}") // snapshot of the wrapped artifact's config
  active     Boolean  @default(false)
  createdAt  DateTime @default(now())
  plugin     Plugin   @relation(fields: [pluginId], references: [pluginId], onDelete: Cascade)

  @@unique([pluginId, version])
}

// ============ V8 — WORLD SCANNER (G1): discover problems from real accumulated intelligence ============
model WorldProblem {
  id                  String   @id @default(cuid())
  problemId           String   @unique // WP-000001
  statement           String
  category            String   @default("")
  whoSuffers          String   @default("") // industry / product / segment that feels it
  frequency           Int      @default(1) // how many real signals/occurrences back it
  urgency             String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  currentAlternatives String   @default("[]") // JSON string[]
  evidence            String   @default("[]") // JSON [{source, detail, type}] — real provenance
  sourceCount         Int      @default(0)
  truthScore          Float    @default(0) // AEGIS grounding
  opportunityScore    Float    @default(0) // 0-100 composite
  dataSource          String   @default("REALITY") // REALITY | MARKET_GAP | FAILED_VENTURE | WEB
  status              String   @default("DISCOVERED") // DISCOVERED | PROMOTED
  opportunityId       String? // set when promoted into the build pipeline
  createdAt           DateTime @default(now())

  @@index([dataSource])
  @@index([status])
}

// ============ V8 — APP DEMAND MARKETPLACE (G8): match apps ↔ demand (network effect) ============
model MarketplaceApp {
  id               String   @id @default(cuid())
  appId            String   @unique // APP-000001
  name             String
  dnaId            String   // its Product DNA fingerprint
  opportunityId    String?
  companyKey       String?
  ownerOrgId       String?
  category         String   @default("")
  keywords         String   @default("[]") // fingerprint tokens (for problem↔app matching)
  problem          String   @default("")
  targetUsers      String   @default("")
  topSegment       String? // best demand segment from its DemandMatch
  demandScore      Float    @default(0)
  improvementIdeas String   @default("[]") // JSON string[] — from customer-sim missing features
  source           String   @default("BUILT") // BUILT | USER_SUBMITTED
  status           String   @default("LISTED") // LISTED | DELISTED
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([category])
  @@index([status])
}

// ============ V8 — DEMAND GRAPH + PRODUCT DNA (G3): match products to the people who need them ============
model ProductDNA {
  id            String   @id @default(cuid())
  dnaId         String   @unique // DNA-000001
  opportunityId String?
  companyKey    String?
  subject       String
  problem       String
  category      String   @default("") // SaaS | Fintech | Healthtech | Devtools | Marketing | Ecommerce | Productivity | AI | Other
  features      String   @default("[]") // JSON string[] (provided or inferred, labelled)
  targetUsers   String   @default("")
  alternatives  String   @default("[]") // JSON string[] — competitors / current solutions
  keywords      String   @default("[]") // fingerprint tokens for matching
  createdAt     DateTime @default(now())

  @@index([opportunityId])
}

model DemandMatch {
  id           String   @id @default(cuid())
  matchId      String   @unique // DM-000001
  dnaId        String
  subject      String
  demandScore  Float    @default(0) // 0-100 DEMAND_MATCH_SCORE (top-segment market fit)
  topSegment   String? // best-fit industry
  segments     String   @default("[]") // JSON: [{industry, community, needScore, adoptionProbability, marketFit, urgency, whyNow}]
  mode         String   @default("HEURISTIC") // adoption from seeded CUSTOMER simulation; fit is heuristic
  artifactPath String? // DEMAND_MAP.md
  createdAt    DateTime @default(now())

  @@index([dnaId])
}

// ============ V8 — AGENT EVOLUTION (G7): agents improve from real performance ============
model EvolutionAction {
  id        String   @id @default(cuid())
  actionId  String   @unique // EVO-000001
  agent     String
  kind      String   // IMPROVE_PROMPT | RETIRE_WORKFLOW | CREATE_SPECIALIST | NO_ACTION
  reason    String   // data-backed explanation
  metrics   String   @default("{}") // JSON snapshot: successRate, executions, errorCount, avgMs
  applied   Boolean  @default(false) // false = dry-run / recommendation only
  detail    String   @default("") // what was done (new prompt version, template key, rollback…)
  createdAt DateTime @default(now())

  @@index([agent])
  @@index([kind])
}

// ============ V8 — AGENT ARENA (G6): teams compete, a judge picks the winner ============
model ArenaCompetition {
  id            String   @id @default(cuid())
  competitionId String   @unique // ARENA-000001
  mission       String
  opportunityId String?
  status        String   @default("RUNNING") // RUNNING | JUDGED | FAILED
  winnerTeam    String? // ALPHA | BETA | GAMMA
  winnerScore   Float    @default(0)
  rationale     String   @default("") // judge's explanation of why the winner won
  boardVerdict  String? // board review of the winning strategy
  boardConfidence Float  @default(0)
  mode          String   @default("HEURISTIC")
  artifactPath  String? // ARENA_RESULT.md
  createdAt     DateTime @default(now())
  entries       ArenaEntry[]

  @@index([status])
}

model ArenaEntry {
  id             String   @id @default(cuid())
  entryId        String   @unique // AE-000001
  competitionId  String
  team           String   // ALPHA | BETA | GAMMA
  focus          String   // innovation | reliability | growth
  positioning    String   // the team's strategic bet, stated
  strategy       String   @default("{}") // JSON: transformed params + plan
  ventureScore   Float    @default(0)
  truthScore     Float    @default(0)
  customerReality Float   @default(0)
  buyRate        Float    @default(0)
  feasibility    Float    @default(0)
  risk           Float    @default(0) // 0-100, higher = riskier
  totalScore     Float    @default(0) // judge's weighted total 0-100
  rank           Int      @default(0) // 1 = winner
  verdict        String   @default("") // WINNER | RUNNER_UP | REJECTED
  scoreBreakdown String   @default("{}") // per-dimension JSON
  createdAt      DateTime @default(now())
  competition    ArenaCompetition @relation(fields: [competitionId], references: [competitionId], onDelete: Cascade)

  @@index([competitionId])
}

// ============ V8 — SAAS FOUNDATION (G10): auth, orgs, roles, audit ============
model AuthUser {
  id          String   @id @default(cuid())
  userId      String   @unique // U-000001
  email       String   @unique
  name        String?
  createdAt   DateTime @default(now())
  memberships Membership[]
  apiKeys     ApiKey[]
}

model Organization {
  id          String   @id @default(cuid())
  orgId       String   @unique // ORG-000001
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  memberships Membership[]
  apiKeys     ApiKey[]
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String   @default("MEMBER") // OWNER | ADMIN | MEMBER | VIEWER
  createdAt DateTime @default(now())
  user      AuthUser     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@unique([userId, orgId])
}

model ApiKey {
  id         String    @id @default(cuid())
  keyId      String    @unique // AK-000001
  prefix     String    // gk_XXXXXXXX — identifies the key without revealing it
  hash       String    @unique // sha256 of the full secret; the plaintext is shown ONCE at creation
  label      String    @default("default")
  userId     String
  orgId      String
  role       String    @default("MEMBER") // effective role this key authenticates as
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  user       AuthUser     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  org        Organization @relation(fields: [orgId], references: [orgId], onDelete: Cascade)

  @@index([hash])
}

model UsageCounter {
  id        String   @id @default(cuid())
  orgId     String
  day       String   // YYYY-MM-DD (UTC)
  count     Int      @default(0)
  limit     Int      @default(2000) // per-org daily mutation cap (override per row)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([orgId, day])
  @@index([orgId])
}

model AuditLog {
  id        String   @id @default(cuid())
  auditId   String   @unique // AL-000001
  actor     String   // userId, or "local" when unenforced
  orgId     String?
  role      String?
  action    String   // APPROVAL_DECIDE | COMPANY_CREATE | OPERATOR_TICK | FEEDBACK_INGEST | KEY_CREATE | BOOTSTRAP …
  target    String?
  detail    String   @default("")
  createdAt DateTime @default(now())

  @@index([orgId])
  @@index([action])
}

// ============ V8 — BENCHMARK ARENA (G12): Genesis measures itself ============
model BenchmarkRun {
  id             String   @id @default(cuid())
  runId          String   @unique // BM-000001
  suite          String   @default("intelligence") // intelligence | full
  autonomyScore  Float    @default(0) // 0-100 weighted composite
  successRate    Float    @default(0) // 0-100 % of tasks that passed their assertion
  totalTasks     Int      @default(0)
  passed         Int      @default(0)
  durationMs     Int      @default(0)
  avgTaskMs      Int      @default(0)
  tokensUsed     Int      @default(0) // real cost — 0 in heuristic mode (honest)
  mode           String   @default("HEURISTIC") // HEURISTIC | MIXED | LLM — reasoning substrate under test
  results        String   @default("[]") // JSON per-task: {id, capability, pass, score, ms, tokens, detail}
  createdAt      DateTime @default(now())

  @@index([suite])
}

// ============ V8 — LONG-HORIZON OPERATOR (G5): operate companies for 30/60/90 days ============
model LongMission {
  id              String    @id @default(cuid())
  missionId       String    @unique // LM-000001
  goal            String
  companyKey      String? // Company being operated
  opportunityId   String? // opportunity the company was built on (weekly venture re-checks)
  horizonDays     Int       @default(30) // 30 | 60 | 90
  status          String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | KILLED
  startedAt       DateTime  @default(now())
  endsAt          DateTime
  lastDailyAt     DateTime?
  lastWeeklyAt    DateTime?
  lastMonthlyAt   DateTime?
  monthlyDecision String? // SCALE | PIVOT | KILL | DOUBLE_DOWN (latest)
  metrics         String    @default("{}") // JSON rolling state (lastVentureScore, taskCounts…)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  reviews         OperatorReview[]

  @@index([status])
}

model OperatorReview {
  id        String   @id @default(cuid())
  reviewId  String   @unique // REV-000001
  missionId String
  kind      String  // DAILY | WEEKLY | MONTHLY | FINAL
  asOf      DateTime // the tick time this review covered (injectable in tests — recorded honestly)
  summary   String
  findings  String   @default("[]") // JSON string[] — problems detected from real rows
  actions   String   @default("[]") // JSON string[] — taskIds created / decisions taken
  metrics   String   @default("{}") // JSON snapshot of the real numbers reviewed
  decision  String? // MONTHLY only: SCALE | PIVOT | KILL | DOUBLE_DOWN
  createdAt DateTime @default(now())
  mission   LongMission @relation(fields: [missionId], references: [missionId], onDelete: Cascade)

  @@index([missionId])
}

// ============ V8 — INTEGRATED AUTONOMOUS PIPELINE (G0): discover → evidence → venture → customers → board → build ============
model VentureRun {
  id                   String   @id @default(cuid())
  runId                String   @unique // RUN-000001
  focus                String? // optional market focus; discovery still runs — never a prescribed idea
  status               String   @default("RUNNING") // RUNNING | PLANNED | BUILT | HALTED_NO_GO | FAILED
  stage                String   @default("DISCOVER") // last stage reached: DISCOVER | VENTURE | CUSTOMER | BOARD | BUILD
  opportunityId        String?
  opportunityTitle     String?
  ventureScore         Float    @default(0)
  ventureVerdict       String? // INVEST | WATCH | PASS
  truthScore           Float    @default(0) // AEGIS aggregate for the opportunity subject
  customerRealityScore Float    @default(0)
  buyRate              Float    @default(0)
  boardVerdict         String? // GO | CONDITIONAL | NO_GO
  boardConfidence      Float    @default(0)
  companyKey           String? // Company row created on a non-NO_GO verdict
  buildSummary         String? // orchestrator pipeline summary when build ran
  mode                 String   @default("HEURISTIC") // honesty: how the intelligence stages reasoned
  stages               String   @default("[]") // JSON stage log: name, ms, summary, labels
  artifactPath         String? // VENTURE_RUN.md
  error                String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CustomerPersona {
  id               String   @id @default(cuid())
  personaId        String   @unique // CUST-000001
  simulationId     String
  industry         String
  role             String
  problemIntensity Float    @default(0) // 0-100 how acute the pain is
  budget           Float    @default(0) // monthly budget available
  currentSolution  String   @default("none")
  decision         String   @default("NO_BUY") // BUY | MAYBE | NO_BUY
  willingnessToPay Float    @default(0)
  objection        String? // primary reason not to buy
  trigger          String? // what would make them buy
  reasoning        String   @default("")
  createdAt        DateTime @default(now())
  simulation       CustomerSimulation @relation(fields: [simulationId], references: [simulationId], onDelete: Cascade)

  @@index([simulationId])
}

